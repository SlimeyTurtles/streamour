// Streamour database schema. See the wiki: Plan: Foundation.
// Change the schema, then `npm run db:migrate -- --name <what-changed>` to
// create a migration. Migrations are applied on container start.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MEMBER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  displayName     String    @map("display_name")
  avatar          String?
  // Null for accounts that only sign in through another identity (e.g. Google).
  passwordHash    String?   @map("password_hash")
  role            Role      @default(MEMBER)
  createdAt       DateTime  @default(now()) @map("created_at")

  sessions       Session[]
  watchProgress  WatchProgress[]
  recentlyPlayed RecentlyPlayed[]
  settings       Setting[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  // SHA-256 of the opaque cookie token; the token itself is never stored.
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  userAgent  String?  @map("user_agent")
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Where a user is in an episode. `episodeKey` is the media-relative path
// ("Show/Season 1/01 - Name.mkv"); renaming a file orphans its row.
model WatchProgress {
  userId     String   @map("user_id")
  episodeKey String   @map("episode_key")
  positionS  Float    @map("position_s")
  // 0 when unknown (imported from a browser that never stored it).
  durationS  Float    @map("duration_s")
  updatedAt  DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, episodeKey])
  @@map("watch_progress")
}

// The continue-watching row: one entry per show, pointing at the episode the
// user last played. Its position comes from watch_progress.
model RecentlyPlayed {
  userId       String   @map("user_id")
  showId       String   @map("show_id")
  episodeKey   String   @map("episode_key")
  lastPlayedAt DateTime @default(now()) @map("last_played_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, showId])
  @@index([userId, lastPlayedAt])
  @@map("recently_played")
}

// Per-user player settings (volume, subtitle position and sync), as strings.
// The allowed keys and their validation live in lib/watch-state.ts.
model Setting {
  userId String @map("user_id")
  key    String
  value  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("settings")
}
